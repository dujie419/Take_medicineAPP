# =========================================================
# App 基础配置
# =========================================================

# 应用名称
# 主要用于后端项目标识、日志输出、Swagger 文档标题等
APP_NAME=Take Medicine API

# 当前运行环境
# development：开发环境
# testing：测试环境
# production：生产环境
APP_ENV=development

# 是否开启调试模式
# 开发环境可以设为 true，方便查看错误
# 生产环境必须设为 false，避免暴露敏感错误信息
DEBUG=true


# =========================================================
# Server 服务配置
# =========================================================

# 后端服务监听地址
# 0.0.0.0 表示允许局域网其他设备访问
# 如果 Android 真机要访问电脑后端，建议使用 0.0.0.0
HOST=0.0.0.0

# 后端服务端口
# FastAPI 默认常用端口是 8000
# 启动后访问：http://127.0.0.1:8000
PORT=8000


# =========================================================
# Database 数据库配置
# =========================================================

# MySQL 数据库连接地址
# 格式：
# mysql+pymysql://用户名:密码@主机地址:端口号/数据库名?charset=utf8mb4
#
# 当前配置含义：
# 用户名：take_user
# 密码：take_pass123
# 主机：127.0.0.1
# 端口：3306
# 数据库：take_medicine
# 字符集：utf8mb4，支持中文和 emoji 等特殊字符
DATABASE_URL=mysql+pymysql://take_user:take_pass123@127.0.0.1:3306/take_medicine?charset=utf8mb4

# Redis
REDIS_URL=redis://127.0.0.1:6379/0


# =========================================================
# JWT 登录认证配置
# =========================================================

# JWT 密钥
# 用于生成和校验登录 Token
# 开发环境可以先用这个默认值
# 生产环境必须改成足够复杂的随机字符串，不能使用默认值
JWT_SECRET_KEY=please-change-this-secret

# JWT 加密算法
# 一般使用 HS256 即可
JWT_ALGORITHM=HS256

# JWT 过期时间，单位：分钟
# 10080 分钟 = 7 天
# 表示用户登录后 Token 默认 7 天有效
JWT_EXPIRE_MINUTES=10080


# =========================================================
# SMS 短信验证码配置
# =========================================================

# 短信模式
# mock：开发测试模式，不真正发送短信
# aliyun：生产模式，使用阿里云短信服务发送验证码
SMS_MODE=mock

# 开发测试验证码
# 当 SMS_MODE=mock 时，用户输入这个验证码即可登录
# 例如测试时手机号输入 13800000000，验证码输入 123456
SMS_TEST_CODE=123456
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_COOLDOWN_SECONDS=60
SMS_MAX_DAILY_SEND=10
SMS_MAX_VERIFY_ATTEMPTS=5

# 阿里云短信 AccessKey ID
# 生产环境使用
# 开发环境 mock 模式下可以为空
ALIYUN_SMS_ACCESS_KEY_ID=

# 阿里云短信 AccessKey Secret
# 生产环境使用
# 不能提交真实值到 Git
ALIYUN_SMS_ACCESS_KEY_SECRET=

# 阿里云短信签名名称
# 需要在阿里云短信控制台申请
# 例如：按时吃药
ALIYUN_SMS_SIGN_NAME=

# 阿里云短信模板 Code
# 需要在阿里云短信控制台申请
# 模板内容一般类似：您的验证码是 ${code}，5分钟内有效
ALIYUN_SMS_TEMPLATE_CODE=


# =========================================================
# AI Recognition AI 图片识药配置
# =========================================================

# AI 识药模式
# bailian：调用阿里云百炼视觉模型进行真实识别
# mock：开发测试模式，返回固定模拟识别结果
AI_RECOGNITION_MODE=bailian

# 阿里云百炼 API Key
# 当 AI_RECOGNITION_MODE=bailian 时需要填写
# 开发 mock 模式下可以为空
# 不能提交真实 Key 到 Git
BAILIAN_API_KEY=

# 阿里云百炼视觉模型名称
# qwen-vl-plus：支持图片理解的视觉模型
# 后续也可以根据实际账号支持情况改成其他视觉模型
BAILIAN_MODEL=qwen-vl-plus


# =========================================================
# Upload 文件上传配置
# =========================================================

# 上传文件保存目录
# 用于保存用户上传的药盒图片、处方图片等
# 建议后端代码中按用户 ID 再分目录保存，例如：
# uploads/user_1/recognition/xxx.jpg
UPLOAD_DIR=uploads

# 最大上传图片大小，单位：MB
# 这里限制为 10MB
# 后端上传接口需要读取这个值并校验文件大小
MAX_UPLOAD_SIZE_MB=10


